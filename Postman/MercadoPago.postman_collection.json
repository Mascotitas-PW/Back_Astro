{
  "info": {
    "_postman_id": "da4936f0-f124-4f24-a823-64e5fbf817f9",
    "name": "Mercado Pago API",
    "description": "Consultas de pagos y órdenes de Mercado Pago. Configura el entorno personal con tu access token y los IDs que quieras consultar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Consultar pago",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/payments/{{payment_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "payments",
            "{{payment_id}}"
          ]
        },
        "description": "Obtiene el detalle de un pago por su ID. El ID de pago puede obtenerse de la respuesta al crear o procesar un pago."
      },
      "response": []
    },
    {
      "name": "Consultar orden",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/orders/{{order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "orders",
            "{{order_id}}"
          ]
        },
        "description": "Obtiene el detalle de una orden por su ID."
      },
      "response": []
    }
  ]
}